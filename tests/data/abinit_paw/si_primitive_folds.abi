# PAW Si2 reference at four primitive momenta folding to Si8 supercell Gamma.
acell 3*10.26
rprim 0 0.5 0.5  0.5 0 0.5  0.5 0.5 0
ntypat 1
znucl 14
natom 2
typat 2*1
xred 0 0 0  0.25 0.25 0.25
ixc 11
ecut 10
pawecutdg 20
nband 12
kptopt 0
nkpt 4
kpt 0 0 0  0 0.5 0.5  0.5 0 0.5  0.5 0.5 0
wtk 4*0.25
istwfk 4*1
iomode 3
iscf 17
tolvrs 1.0d-8
nstep 50
prtwf 1
diemac 12
pp_dirpath "."
pseudos "Si.xml"
